# Never use LICHESS_HUMAN_TOKEN or SENSEROBOT_LICHESS_USERNAME as the bot.
# The bot must be a separate account upgraded via lichess/upgrade.py.

LICHESS_BOT_TOKEN=              # BOT account token (ChessPersonaBot)
LICHESS_BOT_USERNAME=           # Must match token account (case-insensitive)
LICHESS_HUMAN_TOKEN=            # Sainju token — browser /move only, not for AI
SENSEROBOT_LICHESS_USERNAME=    # Physical board account (Sainju)
GEMINI_API_KEY=                 # Required for AI coaching reviews on the game review page (free tier available)
