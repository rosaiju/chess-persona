# Never use LICHESS_HUMAN_TOKEN or SENSEROBOT_LICHESS_USERNAME as the bot.
# The bot must be a separate account upgraded via lichess/upgrade.py.

LICHESS_BOT_TOKEN=              # BOT account token (ChessPersonaBot)
LICHESS_BOT_USERNAME=           # Must match token account (case-insensitive)
LICHESS_HUMAN_TOKEN=            # Sainju token — browser /move only, not for AI
SENSEROBOT_LICHESS_USERNAME=    # Physical board account (Sainju)
GEMINI_API_KEY=                 # Required for AI coaching reviews on the game review page (free tier available)

# ── Language model (optional; sensible defaults if all unset) ─────────────────
# The Gemini free tier allows 20 generate_content requests per DAY *per model*,
# so the app tries several models in turn. Each one adds another 20/day.
# Override the chain (comma-separated, tried in order, fastest first):
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash

# Last-resort local model. Any OpenAI-compatible endpoint (Ollama, LM Studio).
# Leave unset and the chain is Gemini-only — nothing else changes.
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2

# LLM_MAX_OUTPUT_TOKENS=400     # raise if answers come back truncated
# REVIEW_DEADLINE_S=150         # whole-review wall clock
